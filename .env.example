# Copy to .env and fill in. .env is gitignored; never commit it.

# Required for `agentsec check` and anything that calls a model. There is no default on purpose.
# It must be a model that supports tool calling.
OLLAMA_MODEL=

# Optional. Compose defaults to the ollama container, http://ollama:11434.
# For Ollama on the host, run with `--profile host-ollama` and use:
# OLLAMA_BASE_URL=http://host-ollama:11434

# Optional. The port published on 127.0.0.1.
# APP_PORT=8000
